<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.apex</groupId>
    <artifactId>apex</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Apex</name>
    <description>Root aggregator for the Apex engine. Tier bans are declared
        by each tier's group parent, never here (S2.0 §1.3).</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <compiler.version>3.13.0</compiler.version>
        <surefire.version>3.2.5</surefire.version>
        <jspecify.version>1.0.0</jspecify.version>
        <junit.version>5.10.2</junit.version>
        <assertj.version>3.25.3</assertj.version>
        <archunit.version>1.3.0</archunit.version>
        <jqwik.version>1.9.2</jqwik.version>
    </properties>

    <modules>
        <!-- Every module below is a sibling of this aggregator under project/.
             Maven resolves module paths against this POM's own directory, hence
             the ../ prefixes. Keep this list out of the root pom.xml: a project
             directory may not appear twice in one reactor, and the root POM
             already aggregates project/apex-chat, project/apex-core and
             project/apex-platform. -->
        <module>../apex-core</module>
        <module>../apex-platform</module>
        <module>../apex-chat/apex-chat-core</module>
        <module>../apex-chat/apex-chat-domain</module>
        <module>../apex-chat/apex-chat-store-sqlite</module>
        <module>../engine-cli</module>
        <module>../engine-json</module>
        <module>../engine-llm-http</module>
        <module>../engine-memory</module>
        <module>../engine-sandbox</module>
        <module>../engine-store-sqlite</module>
        <module>../engine-tools-impl</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Gate 3 (CONTEXT.md 5) requires ArchUnit in every Tier 0
                 module. Test scope only, matching apex-chat-common. -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.version}</version>
                    <configuration>
                        <release>21</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <failIfNoTests>true</failIfNoTests>
                        <argLine>${argLine}</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
